---
import { getCollection, render } from 'astro:content';
import SideNotesLayout from '../../layouts/SideNotesLayout.astro';

export async function getStaticPaths() {
  // This function creates a static route per md file in /notes during build time
  const posts = await getCollection('notes');
  return posts.map(note => ({
    params: { slug: note.id.replace(/\\.md$/, '') }, props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---
<SideNotesLayout frontmatter={note.data}>
  <Content />
</SideNotesLayout>