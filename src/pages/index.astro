---
import BaseLayout from "../layouts/BaseLayout.astro"
const pageTitle = "rahillah's digital garden";
---

<BaseLayout pageTitle={pageTitle}>
	<!-- This is the index page of my site. It's the first page that should be displayed when visiting it. -->

	<p>hi there!</p>

	<p>i'm rahillah, and this is my personal site and digital garden where i keep notes and references of all the things i'm interested in.</p>

	<p>i'm building this mainly with <a href="https://astro.build">astro</a>. it's still a work in progress!</p>

	<p>
		some features i may want to explore or add:
		<ul>
			<li>display tags at the top of the page</li>
			<li>add backlinks to immediate previous page</li>
		</ul>
	</p>

	<a href={`${import.meta.env.BASE_URL}notes`}>all notes</a>
</BaseLayout>
